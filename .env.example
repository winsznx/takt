# Optional. Server-only; never prefix with NEXT_PUBLIC_.
# Without it, images are entered by hand and everything else works.
GEMINI_API_KEY=

# synthetic-only (default): only Takt's committed synthetic sample images are
# sent to the model. full: any image the worker chooses to send. Use full only
# with a provider tier whose terms fit personal employment records.
TAKT_AI_MODE=synthetic-only

# Optional model override (default gemini-3.8-flash).
TAKT_EXTRACTION_MODEL=
